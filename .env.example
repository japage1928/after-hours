# xAI — prompt → ACE-Step caption/lyrics (Generate). Optional.
XAI_API_KEY=

# ACE-Step via Replicate — required for Generate to work on Vercel.
# To go live: set REPLICATE_API_TOKEN (and Stripe, already set).
REPLICATE_API_TOKEN=
# Optional: pin a Replicate model (default fishaudio/ace-step-1.5)
# ACE_STEP_REPLICATE_MODEL=fishaudio/ace-step-1.5

# Optional override: self-hosted ACE-Step OpenAI-compat host.
# If set, this is used instead of Replicate.
# ACE_STEP_BASE_URL=https://your-ace-step-host
# ACE_STEP_API_KEY=
# ACE_STEP_MODEL=acestep/ACE-Step-v1.5

# Supabase Postgres (required for deployed auth / sessions)
# Use the Transaction pooler URI from:
# https://supabase.com/dashboard/project/qrhnoypojhkjkmzlhjfl?showConnect=true
DATABASE_URL=

# Synced automatically if you link Supabase in the Vercel integration:
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=

# Public Supabase project URL (optional helpers / future client SDK)
# VITE_SUPABASE_URL=https://qrhnoypojhkjkmzlhjfl.supabase.co
# VITE_SUPABASE_ANON_KEY=

# Deployed sign-in (Better Auth → Supabase tables)
VITE_AUTH_ENABLED=true
BETTER_AUTH_URL=https://after-hours-plum.vercel.app
BETTER_AUTH_SECRET=
ADMIN_EMAILS=japage628@gmail.com

# Stripe (Checkout + Customer Portal + webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Create prices with: npm run stripe:setup
STRIPE_PRICE_SONG=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=


# Optional: direct Better Auth social (required for Google/Facebook/X on Vercel).
# Create OAuth apps, then set these on Vercel Production + Preview + Development.
# Google redirect URI:
#   https://after-hours-plum.vercel.app/api/auth/callback/google
#   http://localhost:8080/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
# Optional client hint (auto-detected from the secrets above on deploy if unset):
# VITE_NATIVE_SOCIAL=google,facebook,twitter

# Do NOT use GROK_AUTH preview credentials on Vercel — they only work on
# *.grok-sandbox.com. Leave unset unless you have a real per-app broker client.
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# GROK_AUTH_ISSUER=
